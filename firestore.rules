rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function hasRole(role) {
      return signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == role;
    }
    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasAll(['name', 'phone', 'role', 'createdAt'])
        && request.resource.data.keys().hasOnly(['name', 'phone', 'role', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 100
        && request.resource.data.phone is string
        && request.resource.data.phone.matches('^01[0125][0-9]{8}$')
        && request.resource.data.role in ['owner', 'consumer']
        && request.resource.data.createdAt == request.time;
      // Account type is chosen once; clients cannot switch privileges later.
      allow update, delete: if false;
    }
    function validPhoto(p) { return p is bytes && p.size() > 0 && p.size() <= 122880; }
    function validPhotos(p) {
      return p is list && p.size() >= 1 && p.size() <= 4
        && validPhoto(p[0])
        && (p.size() < 2 || validPhoto(p[1]))
        && (p.size() < 3 || validPhoto(p[2]))
        && (p.size() < 4 || validPhoto(p[3]));
    }
    function validProperty(d) {
      return d.keys().hasOnly(['title', 'type', 'governorate', 'location', 'mode', 'price', 'bedrooms', 'bathrooms', 'area', 'description', 'photoBytes', 'ownerId', 'status', 'createdAt', 'lastConfirmedAt'])
        && d.title is string && d.title.size() > 0 && d.title.size() <= 150
        && d.type is string && d.type.size() <= 50
        && d.governorate is string && d.governorate.size() <= 100
        && d.location is string
        && d.location.size() > 0 && d.location.size() <= 200
        && d.mode in ['rent', 'sale'] && d.status == 'available'
        && d.price is int && d.price > 0
        && d.area is int && d.area > 0
        && d.bedrooms is int && d.bedrooms >= 0 && d.bedrooms <= 100
        && d.bathrooms is int && d.bathrooms >= 0 && d.bathrooms <= 100
        && d.description is string && d.description.size() <= 5000
        && validPhotos(d.photoBytes)
        && d.createdAt == request.time && d.lastConfirmedAt == request.time;
    }
    match /properties/{propertyId} {
      allow read: if resource.data.status == 'available'
        || (signedIn() && resource.data.ownerId == request.auth.uid);
      allow create: if hasRole('owner')
        && request.resource.data.ownerId == request.auth.uid
        && validProperty(request.resource.data);
      // Only the original owner can renew. No other fields can change here.
      allow update: if hasRole('owner')
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastConfirmedAt'])
        && request.resource.data.lastConfirmedAt == request.time;
      allow delete: if false;
    }
    match /viewing_requests/{requestId} {
      allow create: if hasRole('consumer')
        && request.resource.data.keys().hasOnly(['customerName', 'customerPhone', 'propertyId', 'propertyTitle', 'location', 'governorate', 'requestedDate', 'requestedTime', 'status', 'userId', 'ownerId', 'createdAt'])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.customerName is string
        && request.resource.data.customerName.size() > 0
        && request.resource.data.customerName.size() <= 100
        && request.resource.data.customerPhone is string
        && request.resource.data.customerPhone.matches('^01[0125][0-9]{8}$')
        && request.resource.data.requestedDate is timestamp
        && request.resource.data.requestedTime is string
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && get(/databases/$(database)/documents/properties/$(request.resource.data.propertyId)).data.status == 'available'
        && get(/databases/$(database)/documents/properties/$(request.resource.data.propertyId)).data.lastConfirmedAt + duration.value(7, 'd') > request.time
        && request.resource.data.ownerId == get(/databases/$(database)/documents/properties/$(request.resource.data.propertyId)).data.ownerId;
      allow read: if signedIn()
        && (request.auth.uid == resource.data.userId || request.auth.uid == resource.data.ownerId);
      allow update, delete: if false;
    }
  }
}
